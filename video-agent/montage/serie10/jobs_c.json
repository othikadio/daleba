[{"text": "Tu rêves de faire des locks ? On t'apprend.", "ref": "/home/user/daleba/video-agent/voix/refs-fr/ref_upmc-medium.wav", "out": "/home/user/daleba/video-agent/montage/serie10/v01-formation-locks/vo/raw_0.wav", "seed": 11, "ex": 0.6, "cfg": 0.5}, {"text": "Chez Kadyo Coiffure, on ouvre une formation… uniquement pour les locks.", "ref": "/home/user/daleba/video-agent/voix/refs-fr/ref_upmc-medium.wav", "out": "/home/user/daleba/video-agent/montage/serie10/v01-formation-locks/vo/raw_1.wav", "seed": 11, "ex": 0.6, "cfg": 0.5}, {"text": "Départ de locks, entretien, retwist, finitions : les vraies techniques du salon.", "ref": "/home/user/daleba/video-agent/voix/refs-fr/ref_upmc-medium.wav", "out": "/home/user/daleba/video-agent/montage/serie10/v01-formation-locks/vo/raw_2.wav", "seed": 11, "ex": 0.6, "cfg": 0.5}, {"text": "Tu apprends les gestes qu'on fait chaque jour, avec un coiffeur qui vit les locks.", "ref": "/home/user/daleba/video-agent/voix/refs-fr/ref_upmc-medium.wav", "out": "/home/user/daleba/video-agent/montage/serie10/v01-formation-locks/vo/raw_3.wav", "seed": 11, "ex": 0.6, "cfg": 0.5}, {"text": "Les places sont limitées. Écris-nous pour les détails.", "ref": "/home/user/daleba/video-agent/voix/refs-fr/ref_upmc-medium.wav", "out": "/home/user/daleba/video-agent/montage/serie10/v01-formation-locks/vo/raw_4.wav", "seed": 11, "ex": 0.6, "cfg": 0.5}, {"text": "Un dégradé propre, ça se construit. Voici les quatre étapes.", "ref": "/home/user/daleba/video-agent/voix/refs-fr/ref_upmc-medium.wav", "out": "/home/user/daleba/video-agent/montage/serie10/v02-degrade-4-etapes/vo/raw_0.wav", "seed": 11, "ex": 0.6, "cfg": 0.5}, {"text": "Un : on discute. La hauteur, la longueur, le style. Pas de surprise.", "ref": "/home/user/daleba/video-agent/voix/refs-fr/ref_upmc-medium.wav", "out": "/home/user/daleba/video-agent/montage/serie10/v02-degrade-4-etapes/vo/raw_1.wav", "seed": 11, "ex": 0.6, "cfg": 0.5}, {"text": "Deux : la tondeuse, du sabot le plus long au plus co